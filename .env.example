# Copy to .env (gitignored) — docker compose reads it automatically.
# Free API key from https://app.colacloud.us — enables the in-UI registry
# pipelines (wine/beer/spirits pulls from the public COLA registry).
COLACLOUD_API_KEY=

# ── mm second read (docs/plans/mm-ocr-augment.md) ────────────────────────
# MM = multimodal second read: troubled rows get a verbatim re-read of the
# evidence crop, judged deterministically. Default OFF (byte-identical).
# Flags are read at process start — compose users need --force-recreate.
#LABELCHECK_MM_READ=1
# ONE provider knob (also drives the shipped J3 question assist):
#   nvidia (default; needs NVIDIA_API_KEY) | azure (AZURE_VLM_ENDPOINT/
#   AZURE_VLM_KEY/AZURE_VLM_MODEL) | fixture (keyless demo — canned
#   transcriptions, question mode disabled, chips labeled "fixture") | off
#LABELCHECK_VLM_PROVIDER=fixture
#NVIDIA_API_KEY=
#AZURE_VLM_ENDPOINT=
#AZURE_VLM_KEY=
#AZURE_VLM_MODEL=
